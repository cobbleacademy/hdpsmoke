{
  "name": "deid-giftcards-zen-reporting",
  "description": "De-identified CSV of the gift-card table for zen-analytics (java/docs/DEIDENTIFICATION.md section 17), on a dedicated job cluster. See hsm-databricks-udf/DEID_DEPLOYMENT.md.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 14400,
  "tags": { "purpose": "deid-export", "vendor": "zen-analytics" },
  "schedule": {
    "quartz_cron_expression": "0 0 6 1 * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "deid",
      "new_cluster": {
        "spark_version": "16.4.x-scala2.12",
        "node_type_id": "Standard_D8ds_v5",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER",
        "single_user_name": "<service principal application id>",
        "spark_conf": {
          "spark.sql.session.timeZone": "UTC"
        },
        "custom_tags": { "purpose": "deid-export" }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "deid",
      "job_cluster_key": "deid",
      "max_retries": 0,
      "libraries": [
        { "whl": "/Volumes/<catalog>/<schema>/libs/hsm_databricks_udf-0.1.0-py3-none-any.whl" },
        { "pypi": { "package": "psycopg[binary]==3.2.3" } }
      ],
      "python_wheel_task": {
        "package_name": "hsm_databricks_udf",
        "entry_point": "hsm-deid",
        "parameters": [
          "--profile", "/Volumes/<catalog>/<schema>/deid/profiles/zen-reporting.yml",
          "--source-table", "<catalog>.<schema>.giftcards",
          "--key-column", "id",
          "--output-root", "/Volumes/<catalog>/<schema>/deid_out/zen",
          "--secret-scope", "hsm",
          "--hsm-base-url", "https://<hsm-core-service host>/api/sensec/hsm/v2",
          "--hsm-api-version", "V2",
          "--hsm-app-id", "giftcard-deid-databricks",
          "--hsm-auth-mode", "STATIC",
          "--hsm-private-key-key", "deid-private-key",
          "--hsm-token-key", "deid-token",
          "--hsm-ca-cert-key", "deid-ca-bundle",
          "--surrogate-key-edek-id", "<edek_id of deid-giftcard-surrogate>",
          "--surrogate-db", "postgres",
          "--surrogate-db-host", "<postgres host>",
          "--surrogate-db-name", "giftcards",
          "--surrogate-db-user", "deid_export",
          "--surrogate-db-password-key", "deid-surrogate-db-password",
          "--surrogate-partitions", "8",
          "--triggered-by", "databricks-job:deid-giftcards-zen-reporting"
        ]
      }
    }
  ]
}
