<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsm</groupId>
        <artifactId>hsm-bouncy-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hsm-file-store</artifactId>
    <packaging>jar</packaging>
    <name>HSM File Store</name>
    <description>Storage adapters (local disk, ADLS Gen2, Azure Blob) behind one FileStore interface, shared by hsm-bulk-client and hsm-file-service. Kept out of hsm-crypto-client on purpose so the crypto library never drags the Azure Storage SDKs into embedders such as hsm-spark-adapter. Plain Java, no Spring.</description>

    <dependencies>
        <!-- Same azure-identity -> reactor-netty-http HTTP/3 codec + legacy Jackson 2
             escaped-artifact issue as every other module depending on azure-identity in this
             project (see hsm-core-service/pom.xml's comments); identical fix. Needed here for
             AdlsFileStore/AzureBlobFileStore's credential resolution (WorkloadIdentityCredential/
             ManagedIdentityCredential/DefaultAzureCredential, same chain as
             AzureKeyVaultKekClient). -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-http3</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-base</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-compression</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-classes-quic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-native-quic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>jackson-datatype-jsr310</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-base</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-compression</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-classes-quic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>linux-aarch_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>osx-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>osx-aarch_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- ADLS Gen2 file I/O for FileBulkJob's optional storage backend. Version managed by
             the parent's already-imported azure-sdk-bom (1.3.7); no new BOM needed. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-file-datalake</artifactId>
        </dependency>

        <!-- Plain Azure Blob Storage backend (AzureBlobFileStore): for accounts
             without Hierarchical Namespace enabled, or where HNS is enabled but
             "soft delete for blobs" is also on: the ADLS Gen2 Data Lake REST API
             (azure-storage-file-datalake above) rejects certain operations on
             accounts with that combination (a real, Microsoft-documented account
             level conflict, EndpointUnsupportedAccountFeatures, not something
             either SDK or this module can work around). Plain Blob operations have
             no such conflict on any account. Version managed by the same
             azure-sdk-bom as azure-storage-file-datalake, no new BOM needed. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>


        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
