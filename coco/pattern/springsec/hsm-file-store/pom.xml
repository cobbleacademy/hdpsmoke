<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsm</groupId>
        <artifactId>hsm-bouncy-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hsm-file-store</artifactId>
    <packaging>jar</packaging>
    <name>HSM File Store</name>
    <description>Storage adapters (local disk, ADLS Gen2, Azure Blob) behind one FileStore interface, shared by hsm-bulk-client and hsm-file-service. Kept out of hsm-crypto-client on purpose so the crypto library never drags the Azure Storage SDKs into embedders such as hsm-spark-adapter. Plain Java, no Spring.</description>

    <dependencies>
        <!-- Same setup as every module depending on the Azure SDK (see
             hsm-core-service/pom.xml's comments): azure-core-http-netty excluded in
             favour of the JDK HTTP client, and the legacy Jackson 2 artifacts
             excluded and re-declared. Needed here for
             AdlsFileStore/AzureBlobFileStore's credential resolution (WorkloadIdentityCredential/
             ManagedIdentityCredential/DefaultAzureCredential, same chain as
             AzureKeyVaultKekClient). -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>jackson-datatype-jsr310</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Azure SDK HTTP transport: the JDK's own java.net.http client, not
             azure-core-http-netty (excluded from every com.azure dependency in this
             pom). Keeps reactor-netty and its Netty/HTTP-3 subtree off this module's
             classpath entirely. That subtree was built for a different Netty line
             than the rest of the build and failed at runtime with
             NoClassDefFoundError: io/netty/channel/MultiThreadIoEventLoopGroup.
             azure-core discovers this provider via ServiceLoader; with the Netty
             provider absent it is the only one, so no code or config change is
             needed. Version managed by azure-sdk-bom. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-jdk-httpclient</artifactId>
        </dependency>

        <!-- ADLS Gen2 file I/O for FileBulkJob's optional storage backend. Version managed by
             the parent's already-imported azure-sdk-bom (1.3.7); no new BOM needed. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-file-datalake</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Plain Azure Blob Storage backend (AzureBlobFileStore): for accounts
             without Hierarchical Namespace enabled, or where HNS is enabled but
             "soft delete for blobs" is also on: the ADLS Gen2 Data Lake REST API
             (azure-storage-file-datalake above) rejects certain operations on
             accounts with that combination (a real, Microsoft-documented account
             level conflict, EndpointUnsupportedAccountFeatures, not something
             either SDK or this module can work around). Plain Blob operations have
             no such conflict on any account. Version managed by the same
             azure-sdk-bom as azure-storage-file-datalake, no new BOM needed. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


        <!-- The legacy Jackson 2 artifacts excluded from azure-identity above, re-declared
             so their versions come from this build's dependency management (same pattern
             as hsm-bulk-client/pom.xml). The Azure Storage SDKs need them at runtime; without
             these this module only worked because its consumers happened to bring Jackson. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
