<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsm</groupId>
        <artifactId>hsm-bouncy-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hsm-crypto-client</artifactId>
    <packaging>jar</packaging>
    <name>HSM Crypto Client</name>
    <description>Embeddable Java library for hsm-core-service's bulk DEK endpoints (POST /dek/issue, /dek/unwrap): a stateful HsmCryptoClient exposing encrypt/decrypt methods for other JVM applications to import directly, rather than driving a config-file batch job. Plain Java -- no Spring dependency at all -- so importing it never drags Spring Boot autoconfiguration/component-scanning into a host application. hsm-bulk-client (the standalone batch-job CLI) depends on this module too, for the exact same SvcClient/TransportWrapper/DekManager primitives, rather than duplicating them.</description>

    <dependencies>
        <!-- BC-FIPS: local AES-256-GCM (DekManager) and RSA-OAEP-256 transport wrap/unwrap
             (TransportWrapper), same CMVP-validated module every other service in this
             repo uses, not the general-purpose provider. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bc-fips</artifactId>
        </dependency>

        <!-- Builds and RS256-signs the self-issued bearer JWT SelfSignedJwtTokenProvider
             mints, same library hsm-core-service's own RsaJwtValidator/
             SelfSignedAppKeyJwtValidator use to verify it, so the wire format is
             guaranteed compatible without hand-rolling JWT construction. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- SvcClient's request/response marshaling to POST /dek/issue and /dek/unwrap. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Same setup as every module depending on the Azure SDK (see
             hsm-core-service/pom.xml's comments): azure-core-http-netty excluded in
             favour of the JDK HTTP client, and the legacy Jackson 2 artifacts
             excluded and re-declared. Needed for AzureAdTokenProvider's credential resolution (WorkloadIdentityCredential
             -> ManagedIdentityCredential -> DefaultAzureCredential, same chain as
             AzureKeyVaultKekClient). -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>jackson-datatype-jsr310</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Azure SDK HTTP transport: the JDK's own java.net.http client, not
             azure-core-http-netty (excluded from every com.azure dependency in this
             pom). Keeps reactor-netty and its Netty/HTTP-3 subtree off this module's
             classpath entirely. That subtree was built for a different Netty line
             than the rest of the build and failed at runtime with
             NoClassDefFoundError: io/netty/channel/MultiThreadIoEventLoopGroup.
             azure-core discovers this provider via ServiceLoader; with the Netty
             provider absent it is the only one, so no code or config change is
             needed. Version managed by azure-sdk-bom. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-jdk-httpclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
