# Build from the java/ directory (the Maven reactor root):
#   docker build -f docker/Dockerfile.cek-rotation -t cek-rotation-service:1.0.0 .
#
# Ported from cek_rotation/Dockerfile (Python). Headless worker -- no HTTP
# listener, no EXPOSE, no health check endpoint. Same non-root uid/gid (1001)
# convention as the main service, distinct user name.
#
# Base images are pinned by digest (not just tag) so a rebuild can't silently
# pull a different image than the one that was reviewed/scanned -- re-resolve
# and bump deliberately (e.g. `docker buildx imagetools inspect maven:3.9.9-eclipse-temurin-21`)
# rather than tracking the floating tag. Build stage uses the official Maven
# image (bundles Maven on top of Temurin JDK 21) -- plain eclipse-temurin:21-jdk
# has no `mvn` binary at all.
FROM maven:3.9.9-eclipse-temurin-21@sha256:3a4ab3276a087bf276f79cae96b1af04f53731bec53fb2e651aca79e4b10211e AS build
WORKDIR /workspace
COPY pom.xml .
COPY hsm-core-service/pom.xml hsm-core-service/pom.xml
COPY cek-rotation-service/pom.xml cek-rotation-service/pom.xml
COPY cek-rotation-service/src cek-rotation-service/src
RUN mvn -q -pl cek-rotation-service -am package -DskipTests

FROM eclipse-temurin:21-jre-jammy@sha256:d63bd8d9b171999cbed8576f2c76e874dd4856791a358536e5c4d407e77edc13 AS final
RUN groupadd -g 1001 cekrotator \
    && useradd -m -u 1001 -g 1001 -s /usr/sbin/nologin cekrotator

WORKDIR /app
COPY --from=build /workspace/cek-rotation-service/target/cek-rotation-service.jar app.jar
RUN chown -R cekrotator:cekrotator /app

USER cekrotator

ENTRYPOINT ["java", "-jar", "app.jar"]
