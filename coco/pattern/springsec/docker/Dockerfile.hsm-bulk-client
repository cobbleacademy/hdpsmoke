# Build from the java/ directory (the Maven reactor root):
#   docker build -f docker/Dockerfile.hsm-bulk-client -t hsm-bulk-client:1.0.0 .
#
# CLNT for the Tier 3 bulk PoC -- see java/docs/BULK_OPERATIONS.md and
# java/docs/TIER3_POC_BUILD.md. This is the second way to run hsm-bulk-client
# (alongside scripts/build.sh + scripts/run.sh, which stays the recommended
# path for local/manual runs) -- for a Kubernetes Job, see
# helm/hsm-bulk-client-job. Same build/runtime pattern as
# Dockerfile.hsm-core-service (see there for the full rationale on the
# distroless base image and digest pinning) -- this file only differs in
# which module gets built, has no EXPOSE (this process makes only outbound
# calls to hsm-core-service, never listens), and bakes a fixed config path
# into ENTRYPOINT since a K8s Job always mounts the
# per-run job config at the same path (see helm/hsm-bulk-client-job/templates/job.yaml)
# -- changing what a run does means changing the mounted Secret, never rebuilding this image.
FROM maven:3.9.9-eclipse-temurin-21@sha256:3a4ab3276a087bf276f79cae96b1af04f53731bec53fb2e651aca79e4b10211e AS build
WORKDIR /workspace
COPY pom.xml .
COPY hsm-core-service/pom.xml hsm-core-service/pom.xml
COPY hsm-cache-key-rotator/pom.xml hsm-cache-key-rotator/pom.xml
COPY hsm-crypto-client/pom.xml hsm-crypto-client/pom.xml
COPY hsm-crypto-client/src hsm-crypto-client/src
COPY hsm-bulk-client/pom.xml hsm-bulk-client/pom.xml
COPY hsm-file-service/pom.xml hsm-file-service/pom.xml
COPY hsm-file-store/pom.xml hsm-file-store/pom.xml
COPY hsm-spark-adapter/pom.xml hsm-spark-adapter/pom.xml
COPY hsm-file-store/src hsm-file-store/src
COPY hsm-bulk-client/src hsm-bulk-client/src
RUN mvn -q -pl hsm-bulk-client -am package -DskipTests
# Empty directory for BC-FIPS's native libraries (see the ENTRYPOINT comment), copied
# into the final image owned by the runtime user; distroless has no shell to mkdir with.
RUN mkdir -p /workspace/bc-native

# Debian-based distroless, not Ubuntu -- same rationale and same image as
# hsm-core-service's Dockerfile. The :nonroot tag bakes in a fixed uid/gid
# 65532 -- no groupadd/useradd/chown needed, and no shell to run them with
# anyway. This UID must stay in sync with securityContext in
# helm/hsm-bulk-client-job/values.yaml.
FROM gcr.io/distroless/java21-debian13:nonroot@sha256:8ee299a87382317dd56ee4ffdd9c48f0541f1afe33ea2b64f2f880decd82acf6 AS final
WORKDIR /app
COPY --from=build --chown=65532:65532 /workspace/hsm-bulk-client/target/hsm-bulk-client.jar app.jar
COPY --from=build --chown=65532:65532 /workspace/bc-native /opt/bc-native

# No EXPOSE -- unlike every other module in this repo, this process never
# accepts inbound connections (spring.main.web-application-type: none). It
# only calls out to hsm-core-service via SvcClient.
#
# No HEALTHCHECK -- distroless has no shell/curl, same as every other
# Dockerfile here. Not meaningful for a Job anyway: K8s tracks Job/pod
# completion by exit code, not liveness/readiness probes (see
# helm/hsm-bulk-client-job/templates/job.yaml, which defines neither).

# Fixed mount path, not a placeholder -- the Job chart always mounts the
# per-run job.yml Secret at exactly this path (helm/hsm-bulk-client-job's
# job-config volume). This is what makes the image itself config-free: the
# path never changes, only what's mounted there per run.
#
# -XX:-HeapDumpOnOutOfMemoryError / -XX:+DisableAttachMechanism: this process
# holds plaintext DEKs in memory via HsmCryptoClient's caches (bounded by
# DekCache's own maxSize/TTL now, but still real material while resident) --
# see AUTHORIZATION.md's "mTLS does not address client-side DEK memory
# exposure". HeapDumpOnOutOfMemoryError's HotSpot default is already off;
# set explicitly so no inherited/overridden default can silently turn it on.
# DisableAttachMechanism blocks jmap/jcmd-style live dumping via the
# standard JVM attach API -- the easiest way to pull a heap dump from a
# process with mere process-level access, short of a full OS-level core
# dump (which this can't reach from inside a shell-less distroless image;
# see RUNBOOK.md/SPARK_ADAPTER.md for the equivalent OS/container-level
# guidance this Dockerfile can't enforce itself).
# -Dorg.bouncycastle.native.loader.install_dir: BC-FIPS 2.x unpacks small native
# libraries (a CPU-feature probe plus AES/SHA/DRBG acceleration) from its jar at
# startup and loads them. Left at its default (java.io.tmpdir) that crashes the JVM
# with "UnsatisfiedLinkError ... libbc-probe.so: failed to map segment" wherever /tmp
# is mounted noexec. A dedicated directory keeps /tmp non-executable: the chart mounts
# an emptyDir here (bcFips.nativeMode: native). If the directory is not writable -- an
# older chart without that volume -- BC-FIPS falls back to pure Java instead of
# failing (verified), so this image is safe with either chart version. Pure Java on
# purpose: bcFips.nativeMode: java (-Dorg.bouncycastle.native.cpu_variant=java).
ENTRYPOINT ["java", "-XX:-HeapDumpOnOutOfMemoryError", "-XX:+DisableAttachMechanism", "-Dorg.bouncycastle.native.loader.install_dir=/opt/bc-native", "-jar", "app.jar", "--spring.config.additional-location=file:/config/job.yml"]
