<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsm</groupId>
        <artifactId>hsm-bouncy-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>hsm-core-service</artifactId>
    <packaging>jar</packaging>
    <name>HSM Encryption Service</name>
    <description>Centralised AES-256-GCM envelope encryption backed by Azure Key Vault Managed HSM</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Proxy-based AOP for ComponentTimingAspect: spring-aop itself already ships
             transitively via spring-context (part of every spring-boot-starter-*), so
             the only piece actually missing is aspectjweaver, which Spring Boot's
             AopAutoConfiguration auto-detects on the classpath to enable @Aspect/@Around
             proxying with no further config. Spring Boot 4 dropped the
             spring-boot-starter-aop convenience artifact entirely (last published at
             4.0.0-M2 on Maven Central), the same starter-modularization pattern as the
             Flyway/TestRestTemplate splits noted below, so this is declared directly
             rather than via a starter; version still managed by the parent BOM's
             aspectj.version property. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- Spring Boot 4: Flyway's auto-configuration moved out of the general
             autoconfigure module into its own starter, so declaring flyway-core
             directly (as before) no longer pulls in FlywayAutoConfiguration at
             all, and migrations silently never ran. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bc-fips</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>

        <!-- azure-identity -> azure-core-http-netty -> reactor-netty-http:1.3.6 is the
             only path in this project's whole dependency tree that pulls in the
             HTTP/3/QUIC codec family (confirmed via `mvn dependency:tree`);
             azure-security-keyvault-keys/secrets below don't pull azure-core-http-netty
             independently. Excluded here (not just version-managed in the parent pom)
             so the vulnerable 4.2.15.Final coordinates are never referenced by this
             subtree at all, not merely overridden after being resolved; required
             behind a repository proxy that blocks resolving flagged-vulnerable
             versions outright, where even a transient reference during graph
             resolution fails the build. Re-declared explicitly below at the patched
             version so reactor-netty-http's actual runtime need for these classes is
             still satisfied. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-http3</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-base</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-compression</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-classes-quic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-native-quic</artifactId>
                </exclusion>
                <!-- azure-identity -> azure-core:1.58.0 also independently pulls the
                     legacy Jackson 2 line (jackson-core, jackson-annotations,
                     jackson-datatype-jsr310); excluded here for the same reason as the
                     Netty artifacts above, and re-declared explicitly below alongside
                     the logstash-logback-encoder exclusions further down. -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.datatype</groupId>
                    <artifactId>jackson-datatype-jsr310</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-base</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-compression</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-classes-quic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>linux-aarch_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>osx-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>osx-aarch_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-keys</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-secrets</artifactId>
        </dependency>

        <!-- logstash-logback-encoder's own pom.xml declares jackson-databind:2.15.2
             directly; excluded here for the same reason as azure-identity's Jackson
             exclusions above, so this project's build never references that old
             version at all. Re-declared, along with the coordinates excluded from
             azure-identity, as explicit direct dependencies below; all four resolve
             through spring-boot-dependencies' own nested jackson-2-bom:2.21.4 import,
             which was never touched by this project's own overrides. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lets TestRestTemplate use Apache HttpClient instead of java.net.HttpURLConnection,
             which mishandles 401 responses to POST requests ("cannot retry due to server
             authentication, in streaming mode"). -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4: TestRestTemplate moved out of spring-boot-starter-test into
             its own opt-in artifact, plus a runtime dependency on spring-boot-restclient. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Load-test harness only, see java/docs/PERFORMANCE_TESTING.md. Test-scoped so
             it never ships in the Spring Boot fat jar; gatling-charts-highcharts pulls in
             gatling-app/gatling-core/gatling-http transitively, giving the Java DSL
             (io.gatling.javaapi.*) used by the simulations under src/test/java, plus the
             self-contained HTML report writer. Never bound to the normal test/package
             lifecycle (see gatling-maven-plugin below, no executions block) since it
             targets a running service over real HTTP, so it must stay opt-in, invoked
             explicitly via `mvn gatling:test`, the same reasoning BulkVsBatchBenchmark's
             own exec:java-only invocation already established for this repo's other
             measurement tools. -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>3.13.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hsm-core-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Injects docs/architecture-diagram.svg and docs/sequence-diagram.svg into
                 index.html at build time, see generate_demo_index.py's own module
                 docstring for the full reasoning (single source of truth; a separate
                 Python-based project reads this file's raw source, so the SVG markup
                 has to stay textually inline as-is, not be swapped for an element
                 reference).
                 Bound to process-resources, the SAME phase as the normal resource copy
                 (default-resources) that places the checked-in template, still containing
                 @@ARCHITECTURE_DIAGRAM_SVG@@ etc. markers, at this same path, explicitly
                 declared plugin executions run after Maven's own implicit default-lifecycle
                 bindings for that phase, so this always runs second and overwrites the
                 template with the generated file. Excluding static/index.html from the
                 resources plugin's own copy instead, so this could run first at
                 generate-resources, was tried and did not take effect, so this
                 runs-after-and-overwrites approach is used instead; it doesn't depend on
                 that exclude parameter working at all. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-demo-index</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/generate_demo_index.py</argument>
                                <argument>${project.build.outputDirectory}/static/index.html</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- No executions block bound deliberately, see the gatling-charts-highcharts
                 dependency's comment above. Run explicitly: mvn -pl hsm-core-service
                 gatling:test -Dgatling.simulationClass=com.hsm.core.loadtest.EncryptDecryptLoadSimulation -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>4.16.3</version>
            </plugin>
        </plugins>
    </build>
</project>
