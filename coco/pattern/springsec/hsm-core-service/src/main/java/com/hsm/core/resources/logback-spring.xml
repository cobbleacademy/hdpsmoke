<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
      Structured JSON audit event stream: bare "%msg%n" passthrough. AuditLogger
      builds the entire JSON line itself (event, level, logger, host, timestamp,
      plus event-specific fields) and logs it as the message. This mirrors
      Python's logging.basicConfig(format="%(message)s"), where structlog's own
      JSON string was the entire stdout line.
    -->
    <appender name="AUDIT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="audit.json" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
