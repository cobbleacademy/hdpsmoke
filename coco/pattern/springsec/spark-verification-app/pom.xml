<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Deliberately NO parent element: an independent app with its own clean dependency
         resolution, not inheriting hsm_bouncy/java/pom.xml's netty-bom override (which
         forces Netty to a specific patched version project-wide for CVE reasons in that
         reactor, but is exactly what breaks Spark 4.2.0's own RPC layer if inherited,
         since it needs Netty 4.2.x's KQueueIoHandler. Here, spark-sql pulls its own, correct,
         unmodified transitive Netty version. See java/docs/SPARK_ADAPTER.md's "Testing
         locally without a cluster" section for the full reasoning, and README.md in this
         directory for setup/run instructions. -->
    <groupId>com.hsm</groupId>
    <artifactId>spark-verification-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Point these at wherever you copied the two required jars; see README.md.
             Overridable: mvn ... -Dhsm.spark.adapter.jar=/other/path.jar -->
        <hsm.spark.adapter.jar>${project.basedir}/hsm-spark-adapter-1.0.0.jar</hsm.spark.adapter.jar>
        <hsm.bc.fips.jar>${project.basedir}/bc-fips-2.1.1.jar</hsm.bc.fips.jar>
        <!-- Which verification class `mvn compile exec:java` runs. Overridable:
             mvn ... -Dhsm.exec.mainClass=com.hsm.spark.SqlScriptRunnerVerification -->
        <hsm.exec.mainClass>com.hsm.spark.LocalSparkSessionManualVerification</hsm.exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_2.13</artifactId>
            <version>4.2.0</version>
        </dependency>
        <!-- Only needed for HsmSqlScriptRunner verification against a real JDBC source
             (CREATE TABLE ... USING org.apache.spark.sql.jdbc). A real deployment brings
             whatever driver its own source/target database needs; this is just the one
             convenient for local testing (H2). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
        <!-- Only needed for HsmThriftServerBootstrap verification; resolved fresh
             here (not through the java/ reactor), same reasoning as spark-sql above. -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-hive-thriftserver_2.13</artifactId>
            <version>4.2.0</version>
        </dependency>
        <!-- JDBC client to actually connect to the Thrift Server started by
             HsmThriftServerBootstrap and prove it serves real queries, not just
             that the process starts without error. -->
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-jdbc</artifactId>
            <version>2.3.10</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <!-- jdk.tools:jdk.tools is a pre-JDK9 system-scope reference to
                     tools.jar, pulled in transitively by an old Hadoop dependency;
                     tools.jar doesn't exist at all on JDK 9+ (the JPMS module
                     system replaced it), so this must be excluded to build on
                     anything newer than JDK 8. -->
                <exclusion>
                    <groupId>jdk.tools</groupId>
                    <artifactId>jdk.tools</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The hsm-spark-adapter shaded jar (build it in java/hsm-spark-adapter, then
             copy it here, or point hsm.spark.adapter.jar at its target/ path directly).
             Referenced as a local file, not resolved through any Maven repository, since
             it's not published anywhere; it's this project's own build output. -->
        <dependency>
            <groupId>com.hsm</groupId>
            <artifactId>hsm-spark-adapter</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${hsm.spark.adapter.jar}</systemPath>
        </dependency>
        <!-- bc-fips is deliberately EXCLUDED from the shaded jar above (BC-FIPS's own
             module-integrity self-check breaks if it's repackaged into any uber-jar,
             see SPARK_ADAPTER.md); must be added here as its own, untouched jar. Same
             version hsm-crypto-client/pom.xml pins; find it in your local Maven repo
             after building hsm-spark-adapter once (~/.m2/repository/org/bouncycastle/bc-fips/2.1.1/),
             or copy it here directly. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bc-fips</artifactId>
            <version>2.1.1</version>
            <scope>system</scope>
            <systemPath>${hsm.bc.fips.jar}</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${hsm.exec.mainClass}</mainClass>
                    <!-- test scope, not compile or runtime: this needs BOTH the
                         system-scoped local jars (hsm-spark-adapter, bc-fips; Maven
                         excludes system scope from a plain runtime-scope classpath)
                         AND runtime-only transitive deps (Hive's shims, dynamically
                         class-loaded, not referenced at compile time by anything).
                         test is the one scope that pools compile+runtime+system+test. -->
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
