<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsm</groupId>
    <artifactId>hsm-bouncy-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>HSM Bouncy Castle Parent</name>
    <description>Java/Spring Boot + Bouncy Castle port of the Python HSM envelope-encryption service</description>

    <modules>
        <module>hsm-core-service</module>
        <module>cek-rotation-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 3.5.16 was the final OSS patch of the 3.x line; that branch went fully
             EOL 2026-06-30 with no further free security patches available at all.
             4.1.0 is the currently-supported line, patched through 2027-07-31;
             4.0.x itself is already on a shorter runway (EOL 2026-12-31). Pulls in
             Jackson 3 (ObjectMapper is now immutable/builder-based, so every direct
             `new ObjectMapper()` call site in this codebase was updated for this)
             and Spring Security 7 (CSRF on by default for API endpoints, overridden
             the same as before by this project's own explicit SecurityConfig). -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- 1.2.28 pulled in azure-security-keyvault-keys 4.8.8 (CVE-2026-33117). -->
        <azure-sdk-bom.version>1.3.7</azure-sdk-bom.version>
        <!-- CMVP-validated (cert #4943, FIPS 140-3, Security Level 1: the ceiling for
             any software-only crypto module) module, not the general-purpose provider. -->
        <bc-fips.version>2.1.1</bc-fips.version>
        <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
        <logstash-encoder.version>7.4</logstash-encoder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- azure-sdk-bom 1.3.7 still manages netty 4.1.135.Final, which carries
                 CVE-2026-59901/55831/55833/56745 (HIGH); importing netty-bom directly,
                 ahead of azure-sdk-bom below, overrides it to the patched line. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.136.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bc-fips</artifactId>
                <version>${bc-fips.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-encoder.version}</version>
            </dependency>
            <!-- spring-boot-dependencies 3.5.16 still manages 42.7.11, which carries
                 CVE-2026-54291 (HIGH, SCRAM-SHA-256-PLUS downgrade). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- Spring Boot's own starter-parent sets this by default; needed for
                             reflective @RequestParam/@PathVariable name resolution without
                             explicit name="..." on every annotation. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
