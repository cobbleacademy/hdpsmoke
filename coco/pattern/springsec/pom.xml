<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsm</groupId>
    <artifactId>hsm-bouncy-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>HSM Bouncy Castle Parent</name>
    <description>Java/Spring Boot + Bouncy Castle port of the Python HSM envelope-encryption service</description>

    <modules>
        <module>hsm-core-service</module>
        <module>cek-rotation-service</module>
        <module>hsm-bulk-service</module>
        <module>hsm-bulk-client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 3.5.16 was the final OSS patch of the 3.x line; that branch went fully
             EOL 2026-06-30 with no further free security patches available at all.
             4.1.0 is the currently-supported line, patched through 2027-07-31;
             4.0.x itself is already on a shorter runway (EOL 2026-12-31). Pulls in
             Jackson 3 (ObjectMapper is now immutable/builder-based, so every direct
             `new ObjectMapper()` call site in this codebase was updated for this)
             and Spring Security 7 (CSRF on by default for API endpoints, overridden
             the same as before by this project's own explicit SecurityConfig). -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- 1.2.28 pulled in azure-security-keyvault-keys 4.8.8 (CVE-2026-33117). -->
        <azure-sdk-bom.version>1.3.7</azure-sdk-bom.version>
        <!-- CMVP-validated (cert #4943, FIPS 140-3, Security Level 1: the ceiling for
             any software-only crypto module) module, not the general-purpose provider. -->
        <bc-fips.version>2.1.1</bc-fips.version>
        <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
        <logstash-encoder.version>7.4</logstash-encoder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- azure-sdk-bom 1.3.7 still manages netty 4.1.135.Final, which carries
                 CVE-2026-59901/55831/55833/56745 (HIGH); importing netty-bom directly,
                 ahead of azure-sdk-bom below, overrides it to the patched line. Bumping
                 only io.netty:netty-codec (or any single Netty artifact) instead of the
                 whole netty-bom would be wrong, since Netty's sub-modules are only
                 tested to interoperate within the same release; mixing one artifact
                 from a different line risks a split-classpath NoSuchMethodError at
                 runtime. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.136.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- azure-identity -> azure-core-http-netty -> reactor-netty-http:1.3.6
                 hardcodes its own explicit version for the HTTP/3/QUIC codec family;
                 these coordinates aren't in netty-bom:4.1.136.Final's managed list at
                 all (HTTP/3 support doesn't exist on the 4.1.x line), so nothing above
                 overrides them; confirmed via `mvn dependency:tree`, they were the only
                 Netty artifacts not already on 4.1.136.Final. Pinned here to 4.2.16.Final
                 as their own internally-consistent set (matching what reactor-netty-http
                 itself already chose to run this family on), not mixed with the base
                 4.1.x transport/codec stack managed above. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http3</artifactId>
                <version>4.2.16.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-base</artifactId>
                <version>4.2.16.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-compression</artifactId>
                <version>4.2.16.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-classes-quic</artifactId>
                <version>4.2.16.Final</version>
            </dependency>
            <!-- netty-codec-native-quic ships as platform-classified jars; a bare
                 dependencyManagement entry (no classifier) only matches an unclassified
                 dependency, not these, so each platform classifier needs its own entry. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-native-quic</artifactId>
                <version>4.2.16.Final</version>
                <classifier>linux-x86_64</classifier>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-native-quic</artifactId>
                <version>4.2.16.Final</version>
                <classifier>linux-aarch_64</classifier>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-native-quic</artifactId>
                <version>4.2.16.Final</version>
                <classifier>osx-x86_64</classifier>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-native-quic</artifactId>
                <version>4.2.16.Final</version>
                <classifier>osx-aarch_64</classifier>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-native-quic</artifactId>
                <version>4.2.16.Final</version>
                <classifier>windows-x86_64</classifier>
            </dependency>
            <!-- spring-boot-dependencies 4.1.0 manages tools.jackson:jackson-bom at
                 3.1.4; importing a newer jackson-bom directly, ahead of
                 spring-boot-dependencies below, overrides the whole Jackson 3 family to
                 3.2.1 together, for the same reason as netty-bom above: one
                 coordinated release rather than a single overridden artifact. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>3.2.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bc-fips</artifactId>
                <version>${bc-fips.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-encoder.version}</version>
            </dependency>
            <!-- spring-boot-dependencies 3.5.16 still manages 42.7.11, which carries
                 CVE-2026-54291 (HIGH, SCRAM-SHA-256-PLUS downgrade). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <!-- No explicit version here used to leave plugin resolution up to
                         whatever the local Maven installation defaults to; without a pin,
                         an older default (predating <release> support, added in 3.6) can
                         silently fall back to an ancient source/target level, which is
                         exactly how a build reports "records are not supported in -source
                         11" despite <release>21</release> being set below; records need
                         16+. Pinned to 3.15.0, the version already verified against this
                         project's own record-heavy DTOs/config classes throughout this
                         session. -->
                    <version>3.15.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- Spring Boot's own starter-parent sets this by default; needed for
                             reflective @RequestParam/@PathVariable name resolution without
                             explicit name="..." on every annotation. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
